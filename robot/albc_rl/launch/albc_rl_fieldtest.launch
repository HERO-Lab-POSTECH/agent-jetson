<launch>
  <!-- ============================================================= -->
  <!-- JOINT-ONLY SURFACE FIELD TEST                                  -->
  <!-- Brings up the Dynamixel joint driver + RL inference node in    -->
  <!-- one shot. Does NOT start albc_controller (would also command   -->
  <!-- the joints -> conflict). Does NOT start the IMU bridge/teleop  -->
  <!-- (that is launch-agent, which is also the path to toggle the    -->
  <!-- power relay with key 1).                                       -->
  <!--                                                                -->
  <!-- FIELD WORKFLOW:                                                -->
  <!--   1) launch-agent   -> in the launch-agent terminal press 1      -->
  <!--      to turn the power RELAY ON (powers BOTH thrusters and the -->
  <!--      Dynamixel arm; the arm will NOT move until relay is ON).  -->
  <!--   2) launch-rl      -> this file (joint driver + RL node).     -->
  <!--                                                                -->
  <!-- THRUSTER SAFETY: thruster_scale defaults to 0.0 so the RL node -->
  <!-- publishes zero thrust even though the relay is powered. Verify -->
  <!--   rostopic echo /albc/thruster_cmd  (all 6 channels == 0.0).   -->
  <!-- ============================================================= -->

  <!-- Pass-through args mirror albc_rl.launch so CLI override works:  -->
  <!--   roslaunch albc_rl albc_rl_fieldtest.launch thruster_scale:=1.0 -->
  <arg name="encoder_type"        default="gru" />   <!-- shipped pack is 72D gru -->
  <arg name="control_hz"          default="50.0" />
  <arg name="use_board_rates"     default="false" />
  <arg name="home_on_start"       default="false" />  <!-- ramp the arm to
       joint1 0, joint2 pi/2 before the policy starts, so every run has the same initial
       condition and the operator does not have to launch-albc + press 3 + Ctrl-C.
       FAIL-SAFE default since 2026-08-17: homing COMMANDS the arm and cannot unwind a
       wound one, so it stays opt-in until the restart round-trip regression test passes.
       Pass home_on_start:=true per run once the arm is known unwound. -->
  <arg name="joint1_start_max_rad" default="3.14159265358979" /> <!-- refuse to start
       the policy if |joint1| exceeds this; <= 0 disables. See albc_rl.launch. -->
  <arg name="joint_loop_hz"       default="10.0" />   <!-- Dynamixel driver read
       rate. Must be >= control_hz or the policy integrates across repeats of the same
       measurement: at 10 vs 50 that mismatch was 4.6x and the arm oscillated even with
       the per-second gain matched. Raise together with control_hz; watch the driver log
       for read failures, the 1 Mbps bus has to sustain it. -->
  <arg name="joint_delta_scale"   default="0.10" />   <!-- per-TICK joint-target gain.
       Confounded with control_hz (per-second rate = gain x hz). Diagnostic sweep:
       control_hz:=50 joint_delta_scale:=0.02 matches the 10 Hz run's per-second gain
       while keeping the 50 Hz delay. Calm there means gain, noisy means delay. -->
  <!-- ARM PROTECTION pass-through. Rationale and the measurements behind every
       default live in albc_rl.launch next to the same names; they are repeated
       here only so `launch-rl joint2_max_rad:=...` works from the CLI, which is
       how an operator widens a guard deliberately rather than by editing a file.
       Added 2026-08-25 after arm2 fractured. See .community/posts/finding/047. -->
  <arg name="joint2_min_rad"      default="0.09016" />
  <arg name="joint2_max_rad"      default="3.05143" />
  <arg name="joint_current_max_ma" default="900.0" />
  <arg name="joint_current_max_s"  default="0.5" />
  <arg name="start_att_max_deg"   default="30.0" />
  <arg name="thruster_scale"      default="0.0" />
  <arg name="thruster_max_s"      default="0.0" />
  <arg name="imu_yaw_offset_deg"  default="102.0" />
  <arg name="sensor_timeout_s"    default="0.2" />
  <arg name="joint_timeout_s"     default="0.5" />
  <!-- Channel PERMUTATION [fw m0..m5], value = SIM action index.
       MEASURED 2026-08-11 (dry, one channel at a time via b1_channel_probe): every
       firmware channel was driven and the spinning propeller located on a clock
       face with the gripper at 12. Result, fw channel to clock position:
         m0=3h (vertical), m1=1.5h, m2=4.5h, m3=9h (vertical, DEAD), m4=7.5h, m5=10.5h
       The sim side comes from actuators.xacro, which places T0..T3 at the four
       diagonals and T4/T5 on +-x at 0.1445 m; those coordinates reproduce the TAM's
       Mz=+-0.144 and My=+-0.145 to four decimals, so the sim geometry is exact.
       With +x=3h and +y=12h (gripper), the LIVE columns sit at:
         col0=T4 9h, col1=T1 10.5h, col2=T3 1.5h, col3=T5 3h, col4=T2 4.5h, col5=T0 7.5h
       Matching by physical position gives [3, 2, 4, 0, 5, 1]. The previous identity
       default was 90 deg out on all four horizontals and swapped the two verticals.
       (Identity itself replaced [4,0,1,5,2,3] earlier the same day, which had applied
       the sim's own column reorder a SECOND time and routed horizontal commands into
       the vertical motors.) Verify the startup log prints
       order(fw from sim)=[3, 2, 4, 0, 5, 1] before any thrust.
       2026-08-12 evening: RESTORED to [3, 2, 4, 0, 5, 1]. Earlier the same day it
       had been "corrected" to [3, 5, 4, 0, 1, 2] on the grounds that
       _ESC_CHANNEL_ORDER is (4,0,1,5,2,3) "unchanged since 2026-07-03", which is
       false. 3bb042b (2026-07-14) replaced it with (4,1,3,5,2,0), and the deployed
       teacher trained 2026-08-05, after. The stale tuple was read off a month-old
       container checkout. The restored value is no longer derived from any tuple:
       it comes from inverting the DEPLOYED CHECKPOINT'S OWN allocation matrix
       (M = r x F on params/env.yaml:303) and matching each sim column to the
       measured firmware channel by physical position. Full derivation and the
       three independent position records are in thruster_mixer.py's header. -->
  <arg name="thruster_order"      default="[3, 2, 4, 0, 5, 1]" />
  <!-- B1 per-OUTPUT-channel sign table [m0..m5], MEASURED in a restrained tank
       test (indexed by FIRMWARE channel, NOT sim channel, so it stays valid if
       thruster_order is edited). Identity (+1) until measured; keep
       thruster_scale tiny while unmeasured.
       NOTE: scale is applied ONCE, in the RL node above; the mixer does NOT
       re-apply it (that would square the scale). Mixer takes only order+signs. -->
  <arg name="thruster_sign"       default="[1, 1, 1, 1, 1, 1]" />

  <!-- ESC deadband, normalized to the action range. MEASURED 2026-08-12 (dry):
       an ESC stays still inside 1450..1545 us; at span 300 that is |a| < 0.15.
       The mixer inverts it so a=0 stays exactly neutral and a=+-1 keeps full
       authority. REQUIRES the 2026-08-12 firmware (all six channels span 300,
       bias 0). On older firmware the verticals are asymmetric and one scalar
       cannot express that, so set 0.0 until the board is reflashed. -->
  <arg name="thruster_deadband"   default="0.15" />

  <!-- 1) Dynamixel joint driver (publishes arm state, receives absolute-angle cmd) -->
  <node pkg="albc_control" name="joint_angle_command" type="joint_angle_command" output="screen">
    <param name="loop_hz" value="$(arg joint_loop_hz)" />
  </node>

  <!-- 2) RL student-policy inference node (reuse albc_rl.launch node def via include) -->
  <include file="$(find albc_rl)/launch/albc_rl.launch">
    <arg name="encoder_type"       value="$(arg encoder_type)" />
    <arg name="control_hz"         value="$(arg control_hz)" />
    <arg name="use_board_rates"    value="$(arg use_board_rates)" />
    <arg name="joint_delta_scale"  value="$(arg joint_delta_scale)" />
    <arg name="home_on_start"      value="$(arg home_on_start)" />
    <arg name="joint1_start_max_rad" value="$(arg joint1_start_max_rad)" />
    <arg name="joint2_min_rad"     value="$(arg joint2_min_rad)" />
    <arg name="joint2_max_rad"     value="$(arg joint2_max_rad)" />
    <arg name="joint_current_max_ma" value="$(arg joint_current_max_ma)" />
    <arg name="joint_current_max_s" value="$(arg joint_current_max_s)" />
    <arg name="start_att_max_deg"  value="$(arg start_att_max_deg)" />
    <arg name="thruster_scale"     value="$(arg thruster_scale)" />
    <arg name="thruster_max_s"     value="$(arg thruster_max_s)" />
    <arg name="imu_yaw_offset_deg" value="$(arg imu_yaw_offset_deg)" />
    <arg name="sensor_timeout_s"   value="$(arg sensor_timeout_s)" />
    <arg name="joint_timeout_s"    value="$(arg joint_timeout_s)" />
    <!-- this file owns the mixer (block 3 below, with CLI-overridable order/sign/
         deadband). Letting the child launch its own too would put two nodes named
         thruster_mixer on the graph and ROS would kill one of them without saying so. -->
    <arg name="launch_mixer"       value="false" />
  </include>

  <!-- 3) RL thruster mixer: /albc/thruster_cmd (already scaled by the RL node)
          -> per-channel sign table -> /hero_agent/thruster_pwm (firmware ESC sub).
          Does NOT re-apply thruster_scale (RL node owns scale). The firmware
          watchdog (B2) NEUTRALs the ESCs if this node dies, so a crash fails safe. -->
  <node pkg="albc_rl" name="thruster_mixer" type="thruster_mixer.py" output="screen">
    <rosparam param="thruster_order" subst_value="True">$(arg thruster_order)</rosparam>
    <rosparam param="thruster_sign" subst_value="True">$(arg thruster_sign)</rosparam>
    <param name="thruster_deadband" value="$(arg thruster_deadband)" />
  </node>

  <!-- ROSBAG: auto-record core topics for post-hoc field-test diagnosis.
       Captures relay timing (/hero_agent/key_input), joint_states (the topic that
       dropped out in run 1), thruster_cmd (safety), IMU, currents, and /rosout_agg
       (every node log incl. read-fail reasons + STALE). Camera excluded (size).
       Files land in ~/albc_bags/fieldtest_<timestamp>.bag (fixed dir, easy to find). -->
  <node pkg="rosbag" type="record" name="albc_fieldtest_recorder" output="screen"
        args="-o /home/nvidia/albc_bags/fieldtest /albc/joint_states /hero_agent/active_joint1_position_controller/command /hero_agent/active_joint2_position_controller/command /albc/thruster_cmd /hero_agent/thruster_pwm /hero_agent/key_input /hero_agent/sensors /joint_currents /rosout_agg" />
</launch>
