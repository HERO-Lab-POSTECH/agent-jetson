<launch>
  <!-- RL student-policy inference node (50 Hz), 69D attitude-only. -->
  <!-- SURFACE TEST DEFAULT: thruster_scale=0.0 -> thrusters held at 0, joint-only. -->
  <!-- Brief surface thrust burst (args are declared, so CLI override WORKS):       -->
  <!--   roslaunch albc_rl albc_rl.launch thruster_scale:=1.0 thruster_max_s:=2.0   -->
  <arg name="encoder_type"        default="gru" />    <!-- tcn | gru; shipped pack is 72D gru -->
  <arg name="control_hz"          default="50.0" />
  <arg name="use_board_rates"     default="false" />  <!-- true=trust /albc_status angvel -->
  <arg name="home_on_start"       default="false" />  <!-- ramp the arm to joint1 0,
       joint2 pi/2 before the policy starts. np_policy seeds its accumulator from the
       MEASURED angles, so the starting pose is an initial condition of the run, not a
       detail, which is why true is the better experiment and false is the safer
       default. FAIL-SAFE default since 2026-08-17: homing COMMANDS the arm and cannot
       unwind it (it stops at the nearest 0-equivalent, then warns and proceeds), so it
       stays opt-in until the restart round-trip regression test passes. Pass
       home_on_start:=true per run once the arm is known unwound. -->
  <arg name="joint1_start_max_rad" default="3.14159265358979" /> <!-- refuse to start
       the policy if |joint1| exceeds this; <= 0 disables. Sim resets theta1 to
       uniform(-pi, pi) EVERY episode, so the trained +-2-turn budget is measured from
       a near-zero start the real arm does not get for free. -->
  <arg name="joint_delta_scale"   default="0.10" />   <!-- per-TICK joint-target gain,
       np_policy.DELTA_SCALE. Per-second wind rate = this x control_hz, so the two are
       confounded: the 2026-08-13 tank runs calmed 250x at control_hz 10, but that also
       cut the gain 5x. Hold 0.02 at control_hz 50 to isolate observation delay.
       Anything but 0.10 departs from what the checkpoint trained with. -->
  <!-- ARM PROTECTION, added 2026-08-25 after arm2 fractured. Defaults are calibrated
       on the run that broke it (.community/posts/finding/047), not guessed, but they
       are still DECISIONS: arm2's allowable stress has never been measured.
       joint2 window = the manipulability cost the policy trained with,
       w = sqrt|sin theta2| >= 0.3, so [asin(0.09), pi-asin(0.09)] rad. Both ends are
       kinematic singularities. The break run started at joint2 -10.2 deg, OUTSIDE.
       max <= min disables the window.

       EVERY NUMBER BELOW IS AN ANGLE, so all of them depend on the joint2 DATUM --
       Homing Offset J2 = -61, EEPROM addr 20. That offset exists specifically to
       absorb a re-seating residual (5.36 deg on 2026-08-11), which means RE-SEATING
       THE ARM IS THE EVENT THAT MOVES IT. Verify the datum after any reassembly
       before treating these thresholds as meaningful: a 180 deg error trips loudly,
       but a few degrees is SILENT -- it shifts every threshold together and every
       log line still reads normal. The defaults were calibrated on bag data from the
       old arm2 at the old datum (the 174.84 deg ceiling sits only 8.5 deg above the
       observed limit-cycle centre of 166.3 deg), so a small shift either nuisance-
       trips on run 1 or opens a gap above the singularity. If it moved, fix the
       DATUM, not this window: asin(0.09) is in true-angle coordinates and does not
       change, and editing the window would mint a second coordinate system.
       Method: rules-robot-code SKILL.md, rotation-calibration discipline. -->
  <arg name="joint2_min_rad"      default="0.09016" />  <!-- 5.16 deg -->
  <arg name="joint2_max_rad"      default="3.05143" />  <!-- 174.84 deg -->
  <!-- SUSTAINED over-current, not peak: breakaway from rest legitimately draws
       1.1-1.3 A, and the 2026-08-22 arm1 break was 1.0 A SUSTAINED. On the break run
       |I_J2| held above 900 mA for 1.240 s (first at t=4.77 s) while 1000 mA never
       held longer than 0.44 s, so 900/0.5 fires and 1000/0.5 would not.
       <= 0 on either disables. -->
  <arg name="joint_current_max_ma" default="900.0" />
  <arg name="joint_current_max_s"  default="0.5" />
  <!-- Refuse to start above this vehicle tilt, sqrt(roll^2+pitch^2) which is
       invariant under rotate_imu. +-30 deg is the attitude envelope the episodes
       sample (cfg/GyroOffset.cfg). The break run started at 50.58 deg and the
       joint1-only start gate passed it. <= 0 disables. -->
  <arg name="start_att_max_deg"   default="30.0" />
  <arg name="thruster_scale"      default="0.0" />    <!-- 0.0=joint-only surface test, 1.0=live -->
  <arg name="thruster_max_s"      default="0.0" />    <!-- >0 => thrusters latch to 0 after N sec -->
  <arg name="imu_yaw_offset_deg"  default="102.0" /> <!-- CONFIRMED 2026-08-12 (was -78.0, itself 180 deg out; before that 45.0). albc_controller.yaml carries the solve -->
  <arg name="sensor_timeout_s"    default="0.2" />    <!-- IMU staleness gate -->
  <arg name="joint_timeout_s"     default="0.5" />    <!-- /albc/joint_states staleness gate -->
  <arg name="launch_mixer"        default="true" />   <!-- false when the PARENT launch owns
       the mixer. albc_rl_fieldtest.launch includes this file AND runs its own mixer with
       CLI-overridable order/sign/deadband; two nodes named thruster_mixer would collide and
       ROS would silently kill one of them. -->


  <node pkg="albc_rl" name="rl_inference_node" type="rl_inference_node.py" output="screen">
    <param name="encoder_type"       value="$(arg encoder_type)" />
    <param name="control_hz"         value="$(arg control_hz)" />
    <param name="use_board_rates"    value="$(arg use_board_rates)" />
    <param name="joint_delta_scale"  value="$(arg joint_delta_scale)" />
    <param name="home_on_start"      value="$(arg home_on_start)" />
    <param name="joint1_start_max_rad" value="$(arg joint1_start_max_rad)" />
    <param name="joint2_min_rad"     value="$(arg joint2_min_rad)" />
    <param name="joint2_max_rad"     value="$(arg joint2_max_rad)" />
    <param name="joint_current_max_ma" value="$(arg joint_current_max_ma)" />
    <param name="joint_current_max_s" value="$(arg joint_current_max_s)" />
    <param name="start_att_max_deg"  value="$(arg start_att_max_deg)" />
    <param name="thruster_scale"     value="$(arg thruster_scale)" />
    <param name="thruster_max_s"     value="$(arg thruster_max_s)" />
    <param name="imu_yaw_offset_deg" value="$(arg imu_yaw_offset_deg)" />
    <param name="sensor_timeout_s"   value="$(arg sensor_timeout_s)" />
    <param name="joint_timeout_s"    value="$(arg joint_timeout_s)" />
    <!-- weights_dir defaults to ../numpy_port relative to the node file -->
  </node>

  <!-- The mixer is NOT optional. rl_inference_node publishes sim-ordered commands on
       /albc/thruster_cmd, and nothing else in the graph subscribes to that topic, so
       without this node the thrusters sit silently at neutral and the run reads as a
       policy failure. This launch shipped without it and reproduced exactly that.
       No <param> overrides on purpose: thruster_order / thruster_sign / thruster_deadband
       come from thruster_mixer.py's own defaults, which test_deploy_constants.py pins
       against deployed_tam.json. A second copy of those constants in a launch file is a
       second thing to keep in sync, and that is the drift this repo keeps paying for. -->
  <group if="$(arg launch_mixer)">
    <node pkg="albc_rl" name="thruster_mixer" type="thruster_mixer.py" output="screen" />
  </group>
</launch>
